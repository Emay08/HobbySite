<%- include('partials/head') %>
<section class="landing">
  <p class="eyebrow">Welcome back, <%= user.username %></p>
  <h1>What are we doing today?</h1>

  <div class="tiles">
    <a class="tile" href="/mtgo">
      <div class="tile-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="12" height="16" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="8" y="5" width="12" height="16" rx="1.5" class="card-front" stroke="currentColor" stroke-width="1.6"/><path d="M14 10l1.2 2.4 2.6.4-1.9 1.8.5 2.6-2.4-1.3-2.4 1.3.5-2.6-1.9-1.8 2.6-.4z" fill="currentColor"/></svg>
      </div>
      <h2>MTGO Collection Manager</h2>
      <p>Reprint news, Treasure Chest updates, collection value and CSV updates.</p>
      <span class="tile-go">Open →</span>
    </a>

    <a class="tile" href="/showorder">
      <div class="tile-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18M4 3v15c2.5 0 4-2 4-6V3M20 3v15c-2.5 0-4-2-4-6V3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 21h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="15" r="1.6" fill="currentColor"/><path d="M12 16.6v2.4m-1.6-1.2h3.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </div>
      <h2>Dance Recital Scheduler</h2>
      <p>Running order for the year-end dance show: costume-change gaps, hair up/down, early bedtimes and same-night families.</p>
      <span class="tile-go">Open →</span>
    </a>

    <a class="tile" href="/swg/ships">
      <div class="tile-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 4v16M21 4v16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3 12h5.8M15.2 12H21M5.5 6.5l4.2 3.5M18.5 6.5l-4.2 3.5M5.5 17.5l4.2-3.5M18.5 17.5l-4.2-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </div>
      <h2>SWG Ship Builder</h2>
      <p>Star Wars Galaxies starship loadouts: chassis, components, overloads and mass. Loot and crafting to come.</p>
      <span class="tile-go">Open →</span>
    </a>

    <div class="tile tile-empty" aria-hidden="true">
      <p>More tools later</p>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
