<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · Vault</title>
  <link rel="stylesheet" href="/static/style.css?v=<%= assetV %>">
  <link rel="icon" href="/static/favicon.svg?v=<%= assetV %>" type="image/svg+xml">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<% if (user) { %>
<header class="topbar">
  <a class="brand" href="/home">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l8.5 5v10L12 22 3.5 17V7z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 7l4.3 2.5v5L12 17l-4.3-2.5v-5z" fill="currentColor"/></svg>
    Vault
  </a>
  <% const isMtgo = !!(path && path.startsWith('/mtgo')) || (typeof section !== 'undefined' && section === 'mtgo'); %>
  <% if (isMtgo) { %>
  <nav class="subnav">
    <% const navItems = [['/mtgo', 'Highlights', true], ['/mtgo/chest', 'Chest'], ['/mtgo/collection', 'Collection'], ['/mtgo/watch/short', 'Short watch'], ['/mtgo/watch/long', 'Long watch'], ['/mtgo/targets', 'Targets'], ['/mtgo/swaps', 'Swaps'], ['/mtgo/trades', 'Trades'], ['/mtgo/upload', 'Update']]; %>
    <% for (const [href, label, exact] of navItems) { const active = exact ? (path === href || path === href + '/') : path.startsWith(href); %>
      <a href="<%= href %>" class="<%= active ? 'active' : '' %>"><%= label %></a>
    <% } %>
  </nav>
  <% } else if (path && path.startsWith('/swg')) { %>
  <nav class="subnav">
    <% for (const [href, label] of [['/swg/ships', 'Ship Builder'], ['/swg/loot', 'Loot'], ['/swg/crafting', 'Crafting']]) { %>
      <a href="<%= href %>" class="<%= path.startsWith(href) ? 'active' : '' %>"><%= label %></a>
    <% } %>
    <% if (user.nfs) { %>
    <label class="swg-nfs-toggle" title="Off: only ships, components and NPC ships that exist in public SWGEmu"><input type="checkbox" id="swg-nfs" checked> Include NFS content</label>
    <% } %>
  </nav>
  <% if (!user.nfs) { %><meta name="swg-nfs" content="off"><% } %>
  <script src="/static/swg-common.js?v=<%= assetV %>"></script>
  <% } %>
  <% if (isMtgo) { %>
  <form id="nav-search" class="nav-search" method="get" action="/mtgo/go" role="search" autocomplete="off">
    <input type="search" name="q" placeholder="Search cards…  /" aria-label="Search cards" role="combobox" aria-expanded="false" aria-controls="nav-suggest" spellcheck="false">
    <ul id="nav-suggest" class="nav-suggest" role="listbox" hidden></ul>
  </form>
  <% } %>
  <div class="topbar-end">
    <% if (user.isAdmin) { %>
    <a href="/admin" class="icon-link<%= path && path.startsWith('/admin') ? ' active' : '' %>" title="Admin" aria-label="Admin">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><g transform="rotate(-45 11 10)" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><rect x="5.5" y="3" width="11" height="5.5" rx="1.2"/><path d="M8 3v5.5M14 3v5.5"/><path d="M11 8.5v11"/></g><path d="M13.5 21h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    </a>
    <% } %>
    <form method="post" action="/logout" class="logout">
      <button type="submit" class="icon-link" title="Sign out (<%= user.username %>)" aria-label="Sign out">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M6 21V3.5h9V21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M6 3.5l6.5 2.2V21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="10.4" cy="12.5" r=".95" fill="currentColor"/><path d="M15 12h5m-2-2l2 2-2 2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>
  </div>
</header>
<% } %>
<main class="<%= user ? 'container' : '' %>">
