<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <p class="eyebrow">MTGO</p>
    <h1>Update collection</h1>
  </div>
</div>

<div class="layout-2">
  <section>
    <label id="dropzone" class="dropzone" for="file" data-endpoint="/mtgo/upload" data-kind="collection">
      <input id="file" type="file" accept=".csv,text/csv" hidden>
      <svg width="40" height="40" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m0 0l-4 4m4-4l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <strong>Drop your MTGO CSV export here</strong>
      <span class="muted small">or click to choose a file · replaces the stored collection</span>
    </label>
    <label class="check small">
      <input type="checkbox" name="fresh" value="1" data-upload-field>
      <span><strong>Start fresh</strong> — the stored collection is wrong, so don't compare against it: clears recorded collection changes and dismisses all unconfirmed buys/sells. This upload becomes the new starting point.</span>
    </label>

    <div id="status" class="card hidden" aria-live="polite"></div>
  </section>

  <aside>
    <div class="card">
      <h3>How to export</h3>
      <ol class="small steps">
        <li>In the MTGO client, open <strong>Collection</strong>.</li>
        <li>Select the binder that holds everything (usually <em>Full Trade List</em> or your main collection view), then select all cards.</li>
        <li>Right-click → <strong>Export</strong> and choose <strong>CSV</strong>.</li>
        <li>Drop the saved file on the left.</li>
      </ol>
      <p class="small muted">Expected columns: Card Name, Quantity, ID #, Rarity, Set, Collector #, Premium.</p>
    </div>

    <div class="card">
      <h3>Spreadsheet import</h3>
      <p class="small muted">One-time import of your Google Sheet (Treasure Chest tabs and buy/sell list).</p>
      <p class="small"><a href="/mtgo/import">Open the spreadsheet import →</a></p>
    </div>

    <div class="card">
      <h3>Recent uploads</h3>
      <% if (uploads.length === 0) { %>
        <p class="small muted">None yet.</p>
      <% } else { %>
        <table class="table compact">
          <tbody>
          <% for (const u of uploads) { %>
            <tr>
              <td class="small"><%= fmt.dateTime(u.uploadedAt) %></td>
              <td class="num small"><%= fmt.int(u.totalCards) %> cards</td>
              <td class="num small muted">+<%= u.added %> / −<%= u.removed %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      <% } %>
    </div>
  </aside>
</div>
<script src="/static/upload.js?v=<%= assetV %>" defer></script>
<%- include('../partials/foot') %>
