<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <p class="eyebrow">MTGO</p>
    <h1>Highlights</h1>
  </div>
  <div class="stat-inline">
    <span class="muted">Collection</span>
    <strong><%= fmt.tix(summary.totalValue) %></strong>
    <a href="/mtgo/collection" class="link">Browse →</a>
  </div>
</div>

<div class="layout-2">
  <section>
    <div class="chips">
      <a href="/mtgo" class="chip <%= !category ? 'active' : '' %>">All</a>
      <% for (const [key, label] of Object.entries(categories)) { %>
        <a href="/mtgo?category=<%= key %>" class="chip <%= category === key ? 'active' : '' %>"><%= label %></a>
      <% } %>
    </div>

    <% if (highlights.length === 0) { %>
      <div class="card empty-card">
        <p><strong>Nothing yet.</strong></p>
        <p class="muted">Highlights appear here once the Azure monitor function has run. Each new article or page change it finds is stored as a highlight.</p>
      </div>
    <% } else { %>
      <ol class="feed">
        <% for (const h of highlights) { %>
          <li class="feed-item">
            <span class="badge badge-<%= h.category %>"><%= categories[h.category] || h.category %></span>
            <div class="feed-body">
              <% if (/^https?:\/\//i.test(h.url || '')) { %>
                <a href="<%= h.url %>" target="_blank" rel="noopener noreferrer" class="feed-title"><%= h.title %></a>
              <% } else { %>
                <span class="feed-title"><%= h.title %></span>
              <% } %>
              <% if (h.summary) { %><p class="feed-summary"><%= h.summary %></p><% } %>
              <p class="feed-meta"><%= h.source %> · <%= fmt.ago(h.detectedAt) %><% if (h.notified) { %> · <span title="Sent to Telegram">📱 sent</span><% } %></p>
            </div>
          </li>
        <% } %>
      </ol>
    <% } %>
  </section>

  <aside>
    <div class="card">
      <h3>Your lists</h3>
      <ul class="quick-links">
        <li><a href="/mtgo/targets">Price targets</a><span class="pill <%= targetsHit ? 'pill-hit' : '' %>"><%= targetsHit %> hit</span></li>
        <li><a href="/mtgo/swaps">Version swaps</a><span class="pill <%= swapsReady ? 'pill-hit' : '' %>"><%= swapsReady %> ready</span></li>
        <li><a href="/mtgo/watch/short">Short-term watch</a></li>
        <li><a href="/mtgo/watch/long">Long-term watch</a></li>
      </ul>
      <p class="small muted">Hit/ready counts update with the daily price sync.</p>
    </div>
    <div class="card">
      <h3>Monitors</h3>
      <% if (monitors.length === 0) { %>
        <p class="muted small">No monitor has run yet.</p>
      <% } else { %>
        <ul class="monitor-list">
          <% for (const m of monitors) { %>
            <li>
              <span class="dot <%= m.lastError ? 'dot-bad' : 'dot-ok' %>"></span>
              <div>
                <strong><%= m.label || m._id %></strong>
                <span class="muted small">checked <%= fmt.ago(m.lastChecked) %></span>
                <% if (m.lastError) { %><span class="error small"><%= m.lastError %></span><% } %>
              </div>
            </li>
          <% } %>
        </ul>
      <% } %>
    </div>
    <div class="card">
      <h3>Prices</h3>
      <p class="small muted">Last price sync: <%= summary.pricesUpdatedAt ? fmt.dateTime(summary.pricesUpdatedAt) : 'never' %></p>
      <p class="small muted">Last collection upload: <%= summary.lastUpload ? fmt.dateTime(summary.lastUpload.uploadedAt) : 'never' %></p>
    </div>
  </aside>
</div>
<%- include('../partials/foot') %>
