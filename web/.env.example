# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mtgo_manager

# Single-user login. Generate the hash with:  npm run hash-password
ADMIN_USERNAME=me
ADMIN_PASSWORD_HASH=$2a$12$replace.with.output.of.hash-password

# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Set to "production" on Azure (enables secure cookies)
NODE_ENV=development
PORT=3000

# Default daily-move alert % shown on the short-term watch list (the functions app uses its own WATCH_ALERT_PCT)
WATCH_ALERT_PCT=15
